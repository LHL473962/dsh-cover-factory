    "msst_checkpoint": "",
    "bs317_config": "",
    "bs317_checkpoint": "",
    "applio_root": "",
    "applio_python": "",
    "applio_driver": "",
    "rvc_root": "",
    "rvc_python": "",
    "rvc_hubert": "",
    "rvc_rmvpe": "",
    "ytdlp_python": "python",
    "ytdlp_python_fallbacks": [],
    "ncmdump_python": "",
    "ncmdump_python_fallbacks": [],
    "bankDir": "~/.dsh/cover-factory/banks",
    "room_ir": "",
    "model_sources": {
      "msst_repo": "https://github.com/ZFTurbo/Music-Source-Separation-Training.git",
      "melband_kim": "https://huggingface.co/KimberleyJSN/melbandroformer/resolve/main/MelBandRoformer.ckpt",
      "hubert_base": "https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/hubert_base.pt",
      "rmvpe": "https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/rmvpe.pt"
    },
    "model_sizes": {
      "melband_kim": 913106900,
      "hubert_base": 189507909,
      "rmvpe": 181184272
    },
    "model_sha256": {}
  },
  "audio": {
    "sample_rate": 44100,
    "channels": 2,
    "analysis_sr": 16000
  },
  "fetch": {
    "audio_exts": [
      ".wav",
      ".flac",
      ".mp3",
      ".m4a",
      ".aac",
      ".ogg",
      ".opus",
      ".wma",
      ".aif",
      ".aiff",
      ".ape",
      ".wv"
    ],
    "require_copyright_ack": true,
    "search_api": "https://api.bilibili.com/x/web-interface/search/type?search_type=video&keyword=",
    "search_timeout_sec": 20,
    "search_retries": 2,
    "download_timeout_sec": 900,
    "ytdlp_retries": 2,
    "default_limit": 8,
    "min_duration_sec": 60,
    "max_duration_sec": 480,
    "exclude_title_keywords": [
      "伴奏",
      "off vocal",
      "offvocal",
      "instrumental",
      "inst",
      "カラオケ",
      "karaoke"
    ],
    "local_client_dirs": [],
    "local_client_max_depth": 3,
    "local_client_max_files": 2000,
    "local_client_max_size_mb": 200,
    "ncm_timeout_sec": 300
  },
  "reuseModel": "",
  "separate": {
    "model_type": "mel_band_roformer",
    "default_model": "kim",
    "models": {
      "kim": {
        "label": "kim (MelBand-RoFormer)",
        "model_type": "mel_band_roformer",
        "config_key": "msst_config",
        "checkpoint_key": "msst_checkpoint"
      },
      "bs317": {
        "label": "bs317 (BS-RoFormer)",
        "model_type": "bs_roformer",
        "config_key": "bs317_config",
        "checkpoint_key": "bs317_checkpoint"
      }
    },
    "stem_check": {
      "clip_sec": 60,
      "vocal_perc_max": 0.28,
      "vocal_drums_perc": 0.3,
      "inst_gap": 0.08,
      "swap_margin": 0.03,
      "vocal_loud_db": 0
    },
    "extract_instrumental": true,
    "force_cpu": false,
    "device_ids": 0,
    "timeout_sec": 7200
  },
  "select": {
    "low_band": [
      60,
      165
    ],
    "high_band": [
      165,
      500
    ],
    "bimodal_share": 0.2,
    "bimodal_ratio": 1.5,
    "single_voice_share": 0.8,
    "voice_median_split": 200,
    "stereo_corr_min": 0.3,
    "min_duration_sec": 60,
    "ref_weight": 6,
    "outlier_weight": 3,
    "target_weight": 1,
    "timbre_semitone_tol": 2,
    "centroid_tol": 0.35,
    "max_songs": 60
  },
  "clean": {
    "silence_db": -45,
    "trim_pad_ms": 120,
    "highpass": 45,
    "sample_rate": 44100,
    "timeout_sec": 900
  },
  "dataset": {
    "weight_repeat": 1,
    "max_files": 800,
    "pitch_percentiles": [
      5,
      95
    ],
    "timeout_sec": 900
  },
  "train": {
    "model_id_prefix": "cf",
    "bankEnabled": true,
    "epochs": null,
    "steps_per_epoch_est": 75,
    "sec_per_step_est": 0.37,
    "min_epochs": 20,
    "max_epochs": 20000,
    "batch_size": 8,
    "save_every_epoch": 5,
    "sample_rate": 40000,
    "index_algorithm": "Auto",
    "min_vram_gb": 8,
    "allow_cpu": false,
    "timeout_sec": 43200,
    "pretrained_files": [
      "rvc/models/pretraineds/hifi-gan/f0G40k.pth",
      "rvc/models/pretraineds/hifi-gan/f0D40k.pth"
    ]
  },
  "convert": {
    "f0_method": "rmvpe",
    "device": "cuda:0",
    "is_half": true,
    "index_rate": 0.75,
    "protect": 0.33,
    "filter_radius": 3,
    "rms_mix_rate": 1,
    "resample_sr": 0,
    "timeout_sec": 3600
  },
  "mix": {
    "target_lufs": -14,
    "headroom_db": 1,
    "limiter_db": -1.5,
    "limiter_attack_ms": 0.1,
    "limiter_release_ms": 50,
    "polarity_check": true,
    "polarity_max_lag": 300,
    "highpass": 45,
    "warm_freq": 260,
    "warm_gain_db": -1.2,
    "presence": true,
    "presence_freq": 9000,
    "presence_gain_db": 1.6,
    "compressor": {
      "threshold_db": -18,
      "ratio": 2,
      "attack_ms": 10,
      "release_ms": 120
    },
    "ir_wet": 0.3,
    "ir_widen": 1.8,
    "inst_duck_db": -1,
    "inst_widen": 1.15,
    "glue_ratio": 1.3,
    "glue_threshold_db": -15,
    "timeout_sec": 1800
  },
  "qa": {
    "loudness_target": -13,
    "loudness_tol": 1.5,
    "peak_max_db": -0.5,
    "gap_per_min": 12,
    "min_duration_sec": 30,
    "range_semitones": 6,
    "range_coverage": 0.7,
    "voice_ranges": {
      "male": [
        80,
        400
      ],
      "female": [
        150,
        600
      ]
    },
    "timeout_sec": 900
  },
  "export": {
    "folder_name": "翻唱工厂",
    "filename": "{singer}-{target}",
    "mp3_bitrate": "320k",
    "desktop_dir": "",
    "timeout_sec": 900
  }
}